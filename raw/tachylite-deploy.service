[Unit]
Description=Auto-deploy Tachylite Frozen
Before=sleep.target poweroff.target reboot.target halt.target
After=network-online.target
ConditionPathIsMountPoint=/run/media/girlmaxxing/Shared

[Service]
Type=oneshot
User=girlmaxxing
WorkingDirectory=/run/media/girlmaxxing/Shared/Everything/Capstone
ExecStart=/run/media/girlmaxxing/Shared/Everything/Capstone/deploy.sh "Auto-deploy on sleep/shutdown"
TimeoutStartSec=120
Environment=HOME=/home/girlmaxxing
Environment=PATH=/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=sleep.target poweroff.target reboot.target halt.target
